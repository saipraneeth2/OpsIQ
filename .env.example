# OpsIq environment configuration.
# Copy to `.env` and fill in real values. NEVER commit .env.

# --- Runtime ---
OPSIQ_ENV=development
OPSIQ_LOG_LEVEL=INFO
OPSIQ_TIMEZONE=Asia/Kolkata

# --- Database ---
OPSIQ_DATABASE_URL=postgresql+asyncpg://opsiq:opsiq@localhost:5432/opsiq

# --- Telegram delivery ---
OPSIQ_TELEGRAM_TOKEN=              # from @BotFather
OPSIQ_OWNER_CHAT_ID=               # your Telegram chat id (get from @userinfobot)

# --- CCTV / vision ---
OPSIQ_CCTV_PROVIDER=               # hikvision | cpplus | dahua | other
OPSIQ_CCTV_CLOUD_USERNAME=
OPSIQ_CCTV_CLOUD_PASSWORD=
# Store-specific RTSP URLs go in the DB, not here.

# --- Lenskart franchisee portal (per tenant, stored in DB in prod) ---
LENSKART_PORTAL_USERNAME=
LENSKART_PORTAL_PASSWORD=

# --- LLM (v3 features only) ---
ANTHROPIC_API_KEY=

# --- Object storage (v2) ---
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=opsiq-footage
S3_ENDPOINT=                       # e.g. Cloudflare R2 endpoint
